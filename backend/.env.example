# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/freelance_platform?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173,https://viswaas-portfolio.netlify.app

# Admin Bootstrap Credentials (Used during initial seeding)
INITIAL_ADMIN_EMAIL=viswaas@example.com
INITIAL_ADMIN_PASSWORD=admin2026_change_in_production
